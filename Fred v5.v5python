{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\narm_motor_a = Motor(Ports.PORT3, GearSetting.RATIO_36_1, True)\narm_motor_b = Motor(Ports.PORT4, GearSetting.RATIO_36_1, False)\narm = MotorGroup(arm_motor_a, arm_motor_b)\nclawtilt = Motor(Ports.PORT1, GearSetting.RATIO_18_1, False)\nclaw = Motor(Ports.PORT2, GearSetting.RATIO_18_1, False)\nArmAngle = PotentiometerV2(brain.three_wire_port.a)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n\n\n# define variables used for controlling motors based on controller inputs\ncontroller_1_left_shoulder_control_motors_stopped = True\ncontroller_1_right_shoulder_control_motors_stopped = True\ncontroller_1_up_down_buttons_control_motors_stopped = True\n\n# define a task that will handle monitoring inputs from controller_1\ndef rc_auto_loop_function_controller_1():\n    global controller_1_left_shoulder_control_motors_stopped, controller_1_right_shoulder_control_motors_stopped, controller_1_up_down_buttons_control_motors_stopped, remote_control_code_enabled\n    # process the controller input every 20 milliseconds\n    # update the motors based on the input values\n    while True:\n        if remote_control_code_enabled:\n            # check the buttonL1/buttonL2 status\n            # to control claw\n            if controller_1.buttonL1.pressing():\n                claw.spin(FORWARD)\n                controller_1_left_shoulder_control_motors_stopped = False\n            elif controller_1.buttonL2.pressing():\n                claw.spin(REVERSE)\n                controller_1_left_shoulder_control_motors_stopped = False\n            elif not controller_1_left_shoulder_control_motors_stopped:\n                claw.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_left_shoulder_control_motors_stopped = True\n            # check the buttonR1/buttonR2 status\n            # to control arm\n            if controller_1.buttonR1.pressing():\n                arm.spin(FORWARD)\n                controller_1_right_shoulder_control_motors_stopped = False\n            elif controller_1.buttonR2.pressing():\n                arm.spin(REVERSE)\n                controller_1_right_shoulder_control_motors_stopped = False\n            elif not controller_1_right_shoulder_control_motors_stopped:\n                arm.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_right_shoulder_control_motors_stopped = True\n            # check the buttonUp/buttonDown status\n            # to control clawtilt\n            if controller_1.buttonUp.pressing():\n                clawtilt.spin(FORWARD)\n                controller_1_up_down_buttons_control_motors_stopped = False\n            elif controller_1.buttonDown.pressing():\n                clawtilt.spin(REVERSE)\n                controller_1_up_down_buttons_control_motors_stopped = False\n            elif not controller_1_up_down_buttons_control_motors_stopped:\n                clawtilt.stop()\n                # set the toggle so that we don't constantly tell the motor to stop when\n                # the buttons are released\n                controller_1_up_down_buttons_control_motors_stopped = True\n        # wait before repeating the process\n        wait(20, MSEC)\n\n# define variable for remote controller enable/disable\nremote_control_code_enabled = True\n\nrc_auto_loop_thread_controller_1 = Thread(rc_auto_loop_function_controller_1)\n\n#endregion VEXcode Generated Robot Configuration\n\n# ------------------------------------------\n# \n# \tProject:      F.R.E.D\n#\tAuthor:       Caleb Iseminger\n#\tCreated:\n#\tDescription:  VEXcode V5 Python Project\n#   The code to feather the drivetrain throttle was created with help of AI\n# \n# ------------------------------------------\n\n# Library imports\nfrom vex import *\n\n# Begin project code\n\narm.set_stopping(HOLD)\nclaw.set_stopping(HOLD)\nclawtilt.set_stopping(HOLD)\n\nbrain_batt = 0\nBattColor = Color.GREEN\ndef screen_runtime():\n    while True:\n        #draw outer boarder\n        brain.screen.set_fill_color(Color.BLACK)\n        brain.screen.draw_rectangle(5, 5, 230, 230)\n\n        #determine tempature of the left_front motor\n        if left_front.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if left_front.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if left_front.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        else:\n            pass\n        if left_front.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass\n        \n        #draw the left_front motors representitive rectangle\n        brain.screen.draw_rectangle(10, 10, 50, 80)\n\n        #determine the tempature of the left_back motor\n        if left_back.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if left_back.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if left_back.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if left_back.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass\n\n        #draw the left_back  motor rectangle\n        brain.screen.draw_rectangle(10, 150, 50, 80)\n\n        #determine the right_front motor temp\n        if left_front.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if left_front.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if left_front.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        else:\n            pass\n        if left_front.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass\n        #draw the right_front motor rectangle\n        brain.screen.draw_rectangle(180, 10, 50, 80)\n\n        #determine the right_back motor temperature\n        if left_front.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if left_front.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if left_front.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if left_front.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass\n        #draw the right_back motor rectangle\n        brain.screen.draw_rectangle(180, 150, 50, 80)\n\n        # draw lift outline\n        brain.screen.set_fill_color(Color.TRANSPARENT)\n        brain.screen.draw_rectangle(250, 5, 120, 90)\n\n        # determine the tempature of lift motor 1\n        if arm_motor_a.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if arm_motor_a.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if arm_motor_a.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if arm_motor_a.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass    \n        \n        # draw the lift motor rectangle\n        brain.screen.draw_rectangle(255, 10, 50, 80)\n\n        # determine the tempature of lift motor 2\n        if arm_motor_b.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if arm_motor_b.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if arm_motor_b.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if arm_motor_b.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass    \n\n        # draw the lift motor rectangle\n        brain.screen.draw_rectangle(315, 10, 50, 80)\n\n        brain.screen.set_fill_color(Color.BLACK)\n        brain.screen.set_cursor(5, 26)\n        brain.screen.print(\"Lift  Motors\")\n        \n\n        #draw the outline for the claw motors\n        brain.screen.set_fill_color(Color.TRANSPARENT)\n        brain.screen.draw_rectangle(375, 5, 100, 90)\n\n\n        # determine the tempature of claw tilt motor \n        if clawtilt.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if clawtilt.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if clawtilt.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if clawtilt.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass    \n        \n        # draw the lift motor rectangle\n        brain.screen.draw_rectangle(380, 10, 40, 80)\n\n        # determine the tempature of claw tilt motor \n        if claw.temperature(PERCENT) < 35:\n            brain.screen.set_fill_color(Color.GREEN)\n            pass\n        if claw.temperature(PERCENT) >35:\n            brain.screen.set_fill_color(Color.YELLOW)\n            pass\n        if claw.temperature(PERCENT) >45:\n            brain.screen.set_fill_color(Color.ORANGE)\n            pass\n        if claw.temperature(PERCENT) > 75:\n            brain.screen.set_fill_color(Color.RED)\n            pass    \n        \n        # draw the lift motor rectangle\n        brain.screen.draw_rectangle(430, 10, 40, 80)\n        \n        #brain battery\n        brain.screen.set_cursor(10, 26)\n\n        brain.screen.print(brain.battery.voltage(VoltageUnits.VOLT))\n        brain.screen.set_fill_color(Color.WHITE)\n        brain.screen.print(ArmAngle.angle(DEGREES))\n        wait(1, SECONDS)\n        brain.screen.clear_screen()\n        \n\n\n\nfrom vex import *\n\n# Example motor setup — change ports and names to match your robot\nright_front = Motor(Ports.PORT15, GearSetting.RATIO_18_1, False)\nright_back  = Motor(Ports.PORT16, GearSetting.RATIO_18_1, False)\nleft_front = Motor(Ports.PORT20, GearSetting.RATIO_18_1, True)\nleft_back  = Motor(Ports.PORT19, GearSetting.RATIO_18_1, True)\n\nRAMP_STEP = 4\nDEADZONE = 5\nTURN_SCALE = 0.5  # 1.0 = full turning, 0.5 = half turning\n\nleft_speed = 0\nright_speed = 0\n\ndef deadzone(value):\n    return 0 if abs(value) < DEADZONE else value\n\ndef ramp(current, target):\n    if current < target:\n        return min(current + RAMP_STEP, target)\n    if current > target:\n        return max(current - RAMP_STEP, target)\n    return current\n\ndef set_motor_power(motor, power):\n    motor.set_velocity(abs(power), PERCENT)\n    motor.spin(FORWARD if power <= 0 else REVERSE)\n\nThread(screen_runtime)\n\nwhile True:\n    throttle = deadzone(controller_1.axis3.position())\n    turn = -deadzone(controller_1.axis1.position()) * TURN_SCALE\n\n    left_target = throttle + turn\n    right_target = throttle - turn\n\n    # Scale both sides together if either exceeds 100%\n    largest = max(abs(left_target), abs(right_target), 100)\n    left_target = left_target * 100 / largest\n    right_target = right_target * 100 / largest\n\n    left_speed = ramp(left_speed, left_target)\n    right_speed = ramp(right_speed, right_target)\n\n    set_motor_power(left_front, left_speed)\n    set_motor_power(left_back, left_speed)\n    set_motor_power(right_front, right_speed)\n    set_motor_power(right_back, right_speed)\n\n    wait(20, MSEC)\n\n\n\n","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"claw","leftDir":"false","right":"arm","rightDir":"false","upDown":"clawtilt","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[3,4],"name":"arm","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio36_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[1],"name":"clawtilt","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[2],"name":"claw","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[1],"name":"ArmAngle","customName":true,"deviceType":"PotentiometerV2","deviceClass":"potV2","setting":{"id":"partner"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}